              "type": "uint32",
              "longType": "uint32",
              "fullType": "uint32",
              "ismap": false,
              "isoneof": false,
              "oneofdecl": "",
              "defaultValue": ""
            },
            {
              "name": "load_balancing_weight",
              "description": "Weight of the endpoint for weighted load balancing policies. 0 when its source gives none, which gives the\nendpoint the default weight of the client.",
              "label": "",
              "type": "uint32",
              "longType": "uint32",
              "fullType": "uint32",
              "ismap": false,
