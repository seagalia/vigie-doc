          "name": "Endpoint",
          "longName": "Endpoint",
          "fullName": "vigie.eds.v1.Endpoint",
          "description": "Endpoint is one address and port of a service, with its weight. As JSON, its fields are the keys of each object of\nthe `GET /services` answer.",
          "hasExtensions": false,
          "hasFields": true,
          "hasOneofs": false,
          "extensions": [],
          "fields": [
            {
              "name": "ip",
              "description": "IPv4 or IPv6 address. Vigie doesn't resolve host names, so a source that gives a host name passes it on as is, and\na client checking this rule refuses it.",
              "label": "",
              "type": "string",
              "longType": "string",
              "fullType": "string",
              "ismap": false,
              "isoneof": false,
              "oneofdecl": "",
              "defaultValue": ""
            },
