---
// Starlight's header has no slot for top-level links, and SocialIcons is the component it renders in its right group, so
// the links sit here on wide screens, before the GitHub icon. Narrow screens get them from Header instead, so the mobile
// menu, which renders SocialIcons too, doesn't repeat them.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import TopLinks from './TopLinks.astro';
---

<TopLinks class="wide-screen-links" />
<Default />

<style>
	.wide-screen-links {
		margin-inline-end: 0.5rem;
	}

	@media (max-width: 49.99rem) {
		.wide-screen-links {
			display: none;
		}
	}
</style>
